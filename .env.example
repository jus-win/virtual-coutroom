# ── LLM Provider (choose one) ──────────────────────────────────
# Options: "gemini" | "openai"
LLM_PROVIDER=gemini

# ── Google Gemini ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ── OpenAI (alternative) ───────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ── Database ───────────────────────────────────────────────────
DB_PATH=courtroom.db
